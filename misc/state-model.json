{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/StateModel",
    "definitions": {
        "StateModel": {
            "title": "StateModel",
            "description": "ReShare state model definition",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "const": "StateModel"
                },
                "name": {
                    "type": "string",
                    "description": "Name of the state model"
                },
                "desc": {
                    "type": "string",
                    "description": "Description of the state model (e.g., what workflow is modelled)"
                },
                "version": {
                    "type": "string",
                    "description": "Version of the state model in SemVer"
                },
                "selector": {
                    "$ref": "#/definitions/StateModelSelector"
                },
                "states": {
                    "type": "array",
                    "description": "A list of all allowed states",
                    "items": {
                        "$ref": "#/definitions/State"
                    }
                }
            },
            "required": [
                "name",
                "states",
                "type",
                "version"
            ]
        },
        "StateModelServiceType": {
            "type": "string",
            "description": "ISO 18626 service type used by state-model selection and applicability rules.",
            "enum": [
                "Copy",
                "Loan",
                "CopyOrLoan"
            ]
        },
        "StateModelSelector": {
            "type": "object",
            "additionalProperties": false,
            "description": "Criteria used to select this state model for an ISO 18626 request.",
            "properties": {
                "serviceType": {
                    "type": "array",
                    "description": "ISO 18626 service types handled by this state model.",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/definitions/StateModelServiceType"
                    }
                }
            },
            "required": [
                "serviceType"
            ]
        },
        "AppliesTo": {
            "type": "object",
            "additionalProperties": false,
            "description": "Criteria determining whether a state, action, or event applies to a request. When omitted, the element applies to all requests.",
            "properties": {
                "serviceTypes": {
                    "type": "array",
                    "description": "ISO 18626 service types for which this element applies.",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/definitions/StateModelServiceType"
                    }
                }
            },
            "required": [
                "serviceTypes"
            ]
        },
        "State": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the state, use capital letters with underscores"
                },
                "display": {
                    "type": "string",
                    "description": "Human-readable name displayed to user"
                },
                "desc": {
                    "type": "string",
                    "description": "Description of the state, e.g., what situation is modelled by the state"
                },
                "side": {
                    "type": "string",
                    "description": "Indicates which side of the request the state belongs to",
                    "enum": [
                        "REQUESTER",
                        "SUPPLIER"
                    ]
                },
                "appliesTo": {
                    "$ref": "#/definitions/AppliesTo"
                },
                "initial": {
                    "type": "boolean",
                    "description": "Indicates if the state is the initial state of the request",
                    "default": false
                },
                "primaryAction": {
                    "type": "string",
                    "description": "Indicates the unconditional primary action for the state. The value must match the name of one of the actions defined for the state. Use primaryFor on individual actions when the primary action varies by service type."
                },
                "closingAction": {
                    "type": "string",
                    "description": "Indicates the closing action for the state, i.e., the action to be performed when closing the state. The value must match the name of one of the actions defined for the state."
                },
                "editable": {
                    "type": "boolean",
                    "description": "Indicates that a patron request can be updated"
                },
                "actions": {
                    "type": "array",
                    "description": "List of all actions that may be performed on the request when in this state",
                    "items": {
                        "$ref": "#/definitions/Action"
                    }
                },
                "events": {
                    "type": "array",
                    "description": "List of all events that may be triggered to the request when in this state",
                    "items": {
                        "$ref": "#/definitions/Event"
                    }
                },
                "terminal": {
                    "type": "boolean",
                    "description": "Indicates if the state is terminal (meaning no actions or events are allowed when in the state)"
                },
                "needsAttention": {
                    "type": "boolean",
                    "description": "Indicates that this state requires user attention (e.g. displayed as a flag in the UI)"
                },
                "manualClose": {
                    "type": "boolean",
                    "description": "Indicates that this state allows manual closing of the request by the user"
                }
            },
            "oneOf": [
                {
                    "anyOf": [
                        {
                            "required": [
                                "actions"
                            ]
                        },
                        {
                            "required": [
                                "events"
                            ]
                        }
                    ]
                },
                {
                    "required": [
                        "terminal"
                    ]
                }
            ],
            "required": [
                "name",
                "side"
            ],
            "title": "State"
        },
        "Action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Declares an action available while in this state.",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the action"
                },
                "desc": {
                    "type": "string",
                    "description": "Description of the action"
                },
                "trigger": {
                    "type": "string",
                    "description": "Trigger for the action",
                    "enum": [
                        "auto",
                        "manual"
                    ],
                    "default": "manual"
                },
                "appliesTo": {
                    "$ref": "#/definitions/AppliesTo"
                },
                "primaryFor": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/AppliesTo"
                        }
                    ],
                    "description": "Makes this the primary action for the selected service types. At most one applicable action may be primary for a service type in a state."
                },
                "transitions": {
                    "type": "object",
                    "description": "Action outcome to state transition mapping. When no transition is defined, the action is considered to be non-state-changing. A failure transition handles a persisted failure within an automatic action chain; an unbound failure propagates to the parent.",
                    "additionalProperties": false,
                    "properties": {
                        "success": {
                            "type": "string",
                            "description": "Target state when the action succeeds."
                        },
                        "failure": {
                            "type": "string",
                            "description": "Target state when the action fails. Once persisted, this transition prevents the failure from propagating through an automatic action chain."
                        },
                        "review": {
                            "type": "string",
                            "description": "Target state when the action requires review."
                        }
                    }
                },
                "params": {
                    "type": "object",
                    "description": "Action parameters as arbitrary name/value pairs.",
                    "additionalProperties": true,
                    "properties": {
                        "sendTo": {
                            "type": "array",
                            "description": "Notification recipients for this action.",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "patron",
                                    "staff"
                                ]
                            }
                        },
                        "templateLabel": {
                            "type": "string",
                            "description": "Label of the notification template to be used for this action."
                        }
                    }
                }
            },
            "required": [
                "name"
            ],
            "title": "Action"
        },
        "Event": {
            "type": "object",
            "additionalProperties": false,
            "description": "Declares an event considered for transition while in this state.",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the event"
                },
                "desc": {
                    "type": "string",
                    "description": "Description of the event"
                },
                "appliesTo": {
                    "$ref": "#/definitions/AppliesTo"
                },
                "transition": {
                    "type": "string",
                    "description": "State transition after event has occurred. When no transition is defined, the event is considered to be non-state-changing."
                }
            },
            "required": [
                "name"
            ],
            "title": "Event"
        }
    }
}
