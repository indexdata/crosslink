meta {
  name: Lending side cancelled check
  type: http
  seq: 9
}

get {
  url: {{host}}/patron_requests/{{cancellationLendingPrId}}?side=lending
  body: json
  auth: basic
}

params:query {
  side: lending
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  test("HTTP request succeeds", () => {
    expect(res.getStatus()).to.be.within(200, 299);
  });
  test("supplier cancellation completes", function() {
    const pr = res.getBody();
    expect(pr.state).to.equal("CANCELLED");
    expect(pr.terminalState).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
