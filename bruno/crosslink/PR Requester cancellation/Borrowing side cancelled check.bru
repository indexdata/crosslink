meta {
  name: Borrowing side cancelled check
  type: http
  seq: 10
}

get {
  url: {{host}}/patron_requests/{{cancellationPrId}}?side=borrowing
  body: json
  auth: basic
}

params:query {
  side: borrowing
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantReq}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  test("HTTP request succeeds", () => {
    expect(res.getStatus()).to.be.within(200, 299);
  });
  test("requester cancellation completes", function() {
    const pr = res.getBody();
    expect(pr.state).to.equal("CANCELLED");
    expect(pr.terminalState).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
