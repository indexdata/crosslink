meta {
  name: Find lending PR id
  type: http
  seq: 2
}

get {
  url: {{host}}/patron_requests?side=lending&requester_req_id={{openEndedPrId}}
  body: none
  auth: basic
}

params:query {
  side: lending
  requester_req_id: {{openEndedPrId}}
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  const responseData = res.getBody();
  const lendingPr = responseData.items && responseData.items[0];
  test("Check if found lending PR", () => {
      expect(lendingPr).to.exist;
      expect(lendingPr.id).to.be.a("string").and.not.empty;
      // Intentionally set lendingPrId before asserting lastActionResult so later steps can use it
      // for cleanup/diagnostics even if the assertion fails.
      bru.setVar("openEndedLendingPrId", lendingPr.id);
      expect(lendingPr.lastActionResult).to.equal("SUCCESS")
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
