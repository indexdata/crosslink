meta {
  name: Lending side schedule overdue batch
  type: http
  seq: 28
}

post {
  url: {{host}}/batch_actions
  body: json
  auth: basic
}


headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

body:json {
  {
    "title": "Overdue regression {{lendingPrId}}",
    "actionName": "overdue",
    "schedule": "FREQ=SECONDLY;INTERVAL=1",
    "batchQuery": "id = \"{{lendingPrId}}\""
  }
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")));
}

script:post-response {
  test("Schedule an overdue batch for this loan", () => {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("string").and.not.empty;
    bru.setVar("happyOverdueBatchId", res.getBody().id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
