meta {
  name: Lending side overdue check
  type: http
  seq: 27
}

get {
  url: {{host}}/patron_requests/{{lendingPrId}}?side=lending
  body: none
  auth: basic
}

params:query {
  side: lending
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")));
}

script:post-response {
  test("State is OVERDUE with the expected due date", () => {
    expect(res.getStatus()).to.equal(200);
    const pr = res.getBody();
    expect(pr.state).to.equal("OVERDUE");
    expect(Date.parse(pr.dueDate)).to.equal(Date.parse(bru.getVar("loanDueDate")));
    expect(pr.needsAttention).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
