meta {
  name: Borrowing side receive check
  type: http
  seq: 25
}

get {
  url: {{host}}/patron_requests/{{prId}}?side=borrowing
  body: json
  auth: basic
}

params:query {
  side: borrowing
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantReq}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:post-response {
  test("for receive", function() {
    const pr = res.getBody();
    expect(pr.lastAction).to.equal("send-notification")
    expect(pr.lastActionResult).to.equal("SUCCESS")
    expect(pr.state).to.equal("RECEIVED");
    expect(Date.parse(pr.dueDate)).to.equal(Date.parse(bru.getVar("loanDueDate")));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
