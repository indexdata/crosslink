meta {
  name: Lending side overdue hidden
  type: http
  seq: 26
}

get {
  url: {{host}}/patron_requests/{{lendingPrId}}/actions?side=lending
  body: none
  auth: basic
}

params:query {
  side: lending
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")));
}

script:post-response {
  test("Overdue is hidden from staff actions", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().actions.map(action => action.name)).not.to.include("overdue");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
