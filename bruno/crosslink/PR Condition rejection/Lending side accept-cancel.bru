meta {
  name: Lending side accept-cancel
  type: http
  seq: 9
}

post {
  url: {{host}}/patron_requests/{{rejectionLendingPrId}}/action?side=lending
  body: json
  auth: basic
}

params:query {
  side: lending
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{rejectionFirstTenant}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

body:json {
  {
      "action": "accept-cancel"
  }
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  test("HTTP request succeeds", () => {
    expect(res.getStatus()).to.be.within(200, 299);
  });
  test("for success", function() {
    const pr = res.getBody();
    expect(pr.result).to.equal("SUCCESS")
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
