meta {
  name: Create loan with two suppliers
  type: http
  seq: 1
}

post {
  url: {{host}}/patron_requests
  body: json
  auth: basic
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantReq}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

body:json {
  {
      "illRequest": {
        "bibliographicInfo": {
          "supplierUniqueRecordId": "return-{{supplierSymbol}}::{{itemId}};return-{{secondSupplierSymbol}}::{{itemId}}",
          "title" : "Condition rejection regression: continuation and exhaustion"
        },
        "serviceInfo" : {
          "serviceType": "Loan"
        }
      },
      "patron": "{{requesterPatron}}",
      "side": "borrowing",
      "state": "NEW",
      "requesterSymbol": "{{requesterSymbol}}"
  }
}

script:post-response {
  test("HTTP request succeeds", () => {
    expect(res.getStatus()).to.be.within(200, 299);
  });
  const responseData = res.getBody();
  
  test("Capture patron request id", () => {
      expect(responseData.id).to.be.a("string").and.not.empty;
      bru.setVar("rejectionPrId", responseData.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
