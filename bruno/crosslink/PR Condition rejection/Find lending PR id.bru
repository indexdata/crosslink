meta {
  name: Find lending PR id
  type: http
  seq: 3
}

get {
  url: {{host}}/patron_requests?side=lending&requester_req_id={{rejectionPrId}}
  body: none
  auth: basic
}

params:query {
  side: lending
  requester_req_id: {{rejectionPrId}}
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{rejectionFirstTenant}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  test("HTTP request succeeds", () => {
    expect(res.getStatus()).to.be.within(200, 299);
  });
  const responseData = res.getBody();
  const lendingPr = responseData.items && responseData.items[0];
  test("Check if found lending PR", () => {
      expect(lendingPr).to.exist;
      expect(lendingPr.id).to.be.a("string").and.not.empty;
      // Intentionally set rejectionLendingPrId before asserting lastActionResult so later steps can use it
      // for cleanup/diagnostics even if the assertion fails.
      bru.setVar("rejectionLendingPrId", lendingPr.id);
      expect(lendingPr.lastActionResult).to.equal("SUCCESS")
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
