meta {
  name: Lending side cancel-requested check second supplier
  type: http
  seq: 17
}

get {
  url: {{host}}/patron_requests/{{rejectionNextLendingPrId}}?side=lending
  body: json
  auth: basic
}

params:query {
  side: lending
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{rejectionNextTenant}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  test("HTTP request succeeds", () => {
    expect(res.getStatus()).to.be.within(200, 299);
  });
  test("supplier received condition rejection", function() {
    const pr = res.getBody();
    expect(pr.state).to.equal("CANCEL_REQUESTED")
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
