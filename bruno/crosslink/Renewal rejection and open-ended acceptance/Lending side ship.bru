meta {
  name: Lending side ship
  type: http
  seq: 5
}

post {
  url: {{host}}/patron_requests/{{renewalOmittedLendingPrId}}/action?side=lending
  body: json
  auth: basic
}

params:query {
  side: lending
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

body:json {
  {
      "action": "ship",
      "actionParams": {
        "dueDate": "{{renewalOmittedOriginalDueDate}}"
      }
  }
}

script:pre-request {
  bru.setVar("renewalOmittedOriginalDueDate", new Date(Date.now() - 86400000).toISOString());
  bru.sleep(Number(bru.getEnvVar("sleepDelay")))
}

script:post-response {
  test("for success", function() {
    const pr = res.getBody();
    expect(pr.result).to.equal("SUCCESS")
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
