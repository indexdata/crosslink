meta {
  name: Borrowing side renewed check
  type: http
  seq: 17
}

get {
  url: {{host}}/patron_requests/{{renewalOmittedPrId}}?side=borrowing
  body: none
  auth: basic
}

params:query {
  side: borrowing
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantReq}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:pre-request {
  bru.sleep(Number(bru.getEnvVar("sleepDelay")));
}

script:post-response {
  test("State is RENEWED with no due date", () => {
    expect(res.getStatus()).to.equal(200);
    const pr = res.getBody();
    expect(pr.state).to.equal("RENEWED");
    expect(pr.dueDate ?? null).to.equal(null);
    expect(pr.needsAttention).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
