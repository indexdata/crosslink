meta {
  name: Lending side searching check
  type: http
  seq: 4
}

get {
  url: {{host}}/patron_requests/{{recallLendingPrId}}?side=lending
  body: none
  auth: basic
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantSup}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:post-response {
  const waitForState = require("./scripts/wait-for-state");
  const pr = await waitForState(bru, req, res, "SEARCHING");
  test("Pull slip output moves supplier to SEARCHING", function() {
    expect(res.getStatus()).to.equal(200);
    expect(pr.state).to.equal("SEARCHING");
    expect(pr.lastAction).to.equal("pullslip-printed");
    expect(pr.lastActionResult).to.equal("SUCCESS");
  });
}
