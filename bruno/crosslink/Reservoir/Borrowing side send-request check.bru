meta {
  name: Borrowing side send-request check
  type: http
  seq: 2
}

get {
  url: {{host}}/patron_requests/{{prId}}?side=borrowing
  body: json
  auth: basic
}

params:query {
  side: borrowing
}

headers {
  X-Okapi-User-Id: {{userName}}
  X-Okapi-Tenant: {{OkapiTenantReq}}
}

auth:basic {
  username: {{userName}}
  password: {{userPassword}}
}

script:post-response {
  test("for send-request", function() {
    const pr = res.getBody();
    // Automatic action is triggered when request goes in UNFILLED state
    expect(pr.lastAction).to.equal("send-notification")
    // The local stack has no SMTP service; the notification problem is handled.
    expect(pr.lastActionResult).to.equal("PROBLEM")
    expect(pr.lastActionOutcome).to.equal("failure")
    expect(pr.needsAttention).to.equal(true)
    expect(pr.state).to.equal("UNFILLED")
  });
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
